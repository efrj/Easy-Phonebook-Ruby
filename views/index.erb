<div class="hero-section text-center">
  <div class="hero-icon">
    <i class="fa fa-phone-square" aria-hidden="true"></i>
  </div>
  <h1 class="hero-title">Welcome to Easy Phonebook</h1>
  <p class="hero-subtitle">Your modern and elegant contact management solution</p>
  
  <div class="hero-actions">
    <a href="/contact/new" class="btn btn-hero-primary">
      <i class="fa fa-plus-circle"></i> Add New Contact
    </a>
    <a href="#quick-access" class="btn btn-hero-secondary">
      <i class="fa fa-search"></i> Browse Contacts
    </a>
  </div>
</div>

<div id="quick-access" class="features-section">
  <h2 class="section-title">Quick Access by Letter</h2>
  <div class="alphabet-grid">
    <% ('a'..'z').each do |letter| %>
      <a href="/letter/<%= letter %>" class="letter-card">
        <span class="letter"><%= letter.upcase %></span>
      </a>
    <% end %>
  </div>
</div>

<div class="info-section">
  <div class="row">
    <div class="col-md-4">
      <div class="info-card">
        <div class="info-icon">
          <i class="fa fa-bolt"></i>
        </div>
        <h3>Lightning Fast</h3>
        <p>Access your contacts instantly with our optimized search and navigation system.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="info-card">
        <div class="info-icon">
          <i class="fa fa-shield"></i>
        </div>
        <h3>Secure Storage</h3>
        <p>Your contacts are safely stored in XML format with reliable data persistence.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="info-card">
        <div class="info-icon">
          <i class="fa fa-heart"></i>
        </div>
        <h3>Easy to Use</h3>
        <p>Simple and intuitive interface designed for effortless contact management.</p>
      </div>
    </div>
  </div>
</div>