<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Modern and stylish phonebook application">
    <meta name="author" content="">
    <link rel="icon" href="favicon.ico">

    <title>📱 Easy Phonebook</title>

    <!-- Bootstrap core CSS -->
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom styles for this template -->
    <link href="/assets/css/sticky-footer-navbar.css" rel="stylesheet">

    <!-- Font Awesome 4 CDN -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <!-- Custom Styles -->
    <link href="/assets/css/custom-styles.css" rel="stylesheet">
  </head>

  <body>
    <header>
      <!-- Fixed navbar -->
      <nav class="navbar navbar-expand-md navbar-light fixed-top">
        <a class="navbar-brand" href="/"><i class="fa fa-phone-square" aria-hidden="true"></i> Easy Phonebook</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
          <ul class="navbar-nav mr-auto">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown1" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fa fa-address-book"></i> A to H
              </a>
              <div class="dropdown-menu" aria-labelledby="navbarDropdown1">
                <a href="/letter/a" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter A</a>
                <a href="/letter/b" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter B</a>
                <a href="/letter/c" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter C</a>
                <a href="/letter/d" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter D</a>
                <a href="/letter/e" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter E</a>
                <a href="/letter/f" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter F</a>
                <a href="/letter/g" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter G</a>
                <a href="/letter/h" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter H</a>
              </div>
            </li>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown2" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fa fa-address-book"></i> I to Q
              </a>
              <div class="dropdown-menu" aria-labelledby="navbarDropdown2">
                <a href="/letter/i" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter I</a>
                <a href="/letter/j" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter J</a>
                <a href="/letter/k" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter K</a>
                <a href="/letter/l" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter L</a>
                <a href="/letter/m" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter M</a>
                <a href="/letter/n" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter N</a>
                <a href="/letter/o" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter O</a>
                <a href="/letter/p" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter P</a>
                <a href="/letter/q" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter Q</a>
              </div>
            </li>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown3" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fa fa-address-book"></i> R to Z
              </a>
              <div class="dropdown-menu" aria-labelledby="navbarDropdown3">
                <a href="/letter/r" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter R</a>
                <a href="/letter/s" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter S</a>
                <a href="/letter/t" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter T</a>
                <a href="/letter/u" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter U</a>
                <a href="/letter/v" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter V</a>
                <a href="/letter/w" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter W</a>
                <a href="/letter/x" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter X</a>
                <a href="/letter/y" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter Y</a>
                <a href="/letter/z" class="dropdown-item"><i class="fa fa-user"></i> Contacts with letter Z</a>
              </div>
            </li>

            <li class="nav-item">
              <a href="/contact/new" class="btn btn-warning"><i class="fa fa-plus-circle"></i> Create new contact</a>
            </li>
          </ul>
        </div>
      </nav>
    </header>

    <!-- Begin page content -->
    <main role="main" class="container">
      <% if flash[:notice] %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <strong><i class="fa fa-check-circle"></i> Success!</strong> <%= flash[:notice] %>
          <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">×</span>
          </button>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="footer">
      <div class="container">
        <span class="text-muted">
          <p>Easy Phonebook <%=Time.now.year%></p>
        </span>
      </div>
    </footer>

    <!-- Bootstrap core JavaScript
    ================================================== -->
    <!-- Placed at the end of the document so the pages load faster -->
    <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    <script src="/assets/js/vendor/popper.min.js"></script>
    <script src="/assets/js/bootstrap.min.js"></script>
    <script src="/assets/js/main.js"></script>
  </body>
</html>
